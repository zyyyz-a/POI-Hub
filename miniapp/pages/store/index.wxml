<view class="page">
  <view class="card">
    <view class="title">{{store.store_name || '到店服务'}}</view>
    <view class="muted">{{store.address || '在线购买，到店预约和核销'}}</view>
    <view wx:if="{{store.contact_phone_masked}}" class="muted">电话 {{store.contact_phone_masked}}</view>
  </view>
  <view wx:if="{{loading}}" class="card muted">正在加载…</view>
  <view wx:if="{{blocked}}" class="card muted">暂不能营业：{{blocked}}</view>
  <view wx:for="{{products}}" wx:key="id" class="card" bindtap="openProduct" data-id="{{item.id}}">
    <image wx:if="{{item.cover_image}}" src="{{item.cover_image}}" mode="aspectFill" style="width:100%;height:300rpx;border-radius:18rpx" />
    <view class="title">{{item.name}}</view><view class="muted">{{item.description}}</view>
    <view class="price">¥{{item.sale_price / 100}}</view><view class="muted">剩余 {{item.stock}} 份</view>
  </view>
</view>
