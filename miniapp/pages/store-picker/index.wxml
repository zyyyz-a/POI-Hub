<view class="page">
  <view class="card">
    <view class="title">附近门店优惠</view>
    <view class="muted" style="margin-top:8rpx">结合您的当前位置，展示附近入驻门店及优惠信息</view>
    <view class="btn btn-primary btn-block" style="margin-top:20rpx" bindtap="locate">
      {{locating ? '正在获取位置…' : (located ? '重新定位并按距离排序' : '查看我附近的门店')}}
    </view>
    <input class="picker-search" style="margin-top:16rpx" value="{{keyword}}" bindinput="onKeyword" placeholder="搜索附近门店" confirm-type="search" />
  </view>

  <page-state
    wx:if="{{state !== 'content'}}"
    state="{{state}}"
    message="{{message}}"
    bind:action="load"
  />

  <view
    wx:for="{{visible}}"
    wx:key="store_code"
    class="card"
    bindtap="choose"
    data-code="{{item.store_code}}"
  >
    <view class="row">
      <image wx:if="{{item.cover_image || item.logo}}" class="thumb" src="{{item.cover_image || item.logo}}" mode="aspectFill" />
      <view wx:else class="thumb thumb-placeholder">门店</view>
      <view class="grow">
        <view class="row-between">
          <view class="subtitle">{{item.store_name}}</view>
          <view class="tag {{item.business_status === 'preparing' ? 'tag-warning' : (item.business_status === 'closed' ? 'tag-muted' : 'tag-success')}}">{{item.status_text}}</view>
        </view>
        <view wx:if="{{item.distance_text}}" class="muted">距您 {{item.distance_text}}</view>
        <view class="muted ellipsis">{{item.city || ''}}{{item.district || ''}}</view>
        <view class="muted ellipsis">{{item.address}}</view>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="btn btn-ghost btn-block" bindtap="scan">扫描门店二维码</view>
  </view>
</view>
