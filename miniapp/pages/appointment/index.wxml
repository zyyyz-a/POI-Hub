<view class="page with-bottom-bar">
  <block wx:if="{{!done}}">
    <view class="card">
      <view class="section-title">选择日期</view>
      <view class="chip-row">
        <view
          wx:for="{{days}}"
          wx:key="value"
          class="chip {{day === item.value ? 'chip-active' : ''}}"
          bindtap="selectDay"
          data-value="{{item.value}}"
        >{{item.label}}</view>
      </view>
    </view>

    <view class="card">
      <view class="section-title">选择时段</view>
      <view class="chip-row">
        <view
          wx:for="{{times}}"
          wx:key="*this"
          class="chip {{time === item ? 'chip-active' : ''}}"
          bindtap="selectTime"
          data-value="{{item}}"
        >{{item}}</view>
      </view>
    </view>

    <view class="card">
      <view class="section-title">联系人信息</view>
      <view class="field">
        <view class="field-label">联系人</view>
        <input class="field-input" value="{{name}}" data-name="name" bindinput="field" placeholder="请输入姓名" />
      </view>
      <view class="field">
        <view class="field-label">手机号</view>
        <input class="field-input" type="number" value="{{phone}}" data-name="phone" bindinput="field" placeholder="请输入手机号" />
      </view>
      <view class="field">
        <view class="field-label">备注</view>
        <input class="field-input" value="{{note}}" data-name="note" bindinput="field" placeholder="选填" />
      </view>
      <view wx:if="{{error}}" class="form-error">{{error}}</view>
    </view>
  </block>

  <view wx:if="{{done}}" class="card">
    <view class="title">预约成功</view>
    <view class="muted" style="margin-top:12rpx">已为你预约 {{day}} {{time}}，请按预约时间到店，出示券码核销。</view>
    <view class="muted" style="margin-top:12rpx">如需改约或取消，请联系门店客服。</view>
  </view>
</view>

<view class="bottom-bar">
  <view wx:if="{{!done}}" class="btn btn-primary btn-block {{submitting ? 'disabled' : ''}}" bindtap="submit">{{submitting ? '提交中…' : '确认预约'}}</view>
  <view wx:else class="btn btn-primary btn-block" bindtap="goVoucher">查看券码</view>
</view>
