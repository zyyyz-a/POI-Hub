<view class="page"><view class="card"><view class="title">预约到店时间</view><picker mode="date" bindchange="setDate"><view class="input">日期：{{date || '请选择'}}</view></picker><picker mode="time" bindchange="setTime"><view class="input">时间：{{time}}</view></picker><input placeholder="联系人" data-name="contactName" bindinput="field" /><input placeholder="联系电话" type="number" data-name="contactPhone" bindinput="field" /><textarea placeholder="备注" data-name="note" bindinput="field" /><button class="button" bindtap="submit">确认预约</button></view></view>
