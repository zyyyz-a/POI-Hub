<view class="page with-bottom-bar">
  <page-state
    wx:if="{{state !== 'content'}}"
    state="{{state}}"
    message="{{message}}"
    bind:action="load"
  />

  <block wx:if="{{product}}">
    <image wx:if="{{product.cover_image}}" class="detail-cover" src="{{product.cover_image}}" mode="aspectFill" />

    <view class="card">
      <view class="title">{{product.name}}</view>
      <view class="row" style="margin-top:12rpx;align-items:baseline">
        <view class="price"><text class="price-symbol">¥</text>{{product.sale_price / 100}}</view>
        <view class="price-strike">¥{{product.market_price / 100}}</view>
        <view class="muted" style="margin-left:16rpx">已售 {{product.sold_count}}</view>
      </view>
    </view>

    <view class="card">
      <view class="section-title">套餐内容</view>
      <view class="muted">{{product.description || '以门店实际服务为准。'}}</view>
    </view>

    <view class="card">
      <view class="section-title">预约与使用规则</view>
      <view class="bullet"><text class="bullet-dot">·</text><text>{{product.appointment_required ? '需提前预约后到店使用' : '无需预约，到店即可使用'}}</text></view>
      <view class="bullet"><text class="bullet-dot">·</text><text>预计服务时长约 {{product.service_minutes}} 分钟</text></view>
      <view class="bullet"><text class="bullet-dot">·</text><text>长发、漂色或指定发型师可能产生补差，请付款前咨询门店</text></view>
      <view class="bullet"><text class="bullet-dot">·</text><text>{{product.stock_text}}</text></view>
    </view>

    <view class="card">
      <view class="section-title">退款说明</view>
      <view class="bullet"><text class="bullet-dot">·</text><text>未核销且未过期，可按门店规则在小程序内申请退款</text></view>
      <view class="bullet"><text class="bullet-dot">·</text><text>已核销或已过期不支持无理由退款</text></view>
      <view class="bullet"><text class="bullet-dot">·</text><text>退款将原路退回微信支付账户</text></view>
    </view>
  </block>
</view>

<view wx:if="{{product}}" class="bottom-bar">
  <view class="price"><text class="price-symbol">¥</text>{{product.sale_price / 100}}</view>
  <view class="btn btn-primary {{product.stock <= 0 ? 'disabled' : ''}}" bindtap="buy">{{product.stock <= 0 ? '已售罄' : '立即购买'}}</view>
</view>
