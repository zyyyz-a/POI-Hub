.ps {
  padding: 80rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.ps-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #E5E7EB;
  border-top-color: #1677FF;
  border-radius: 50%;
  animation: ps-spin 0.8s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes ps-spin {
  to { transform: rotate(360deg); }
}

.ps-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.ps-muted {
  color: #6B7280;
  font-size: 26rpx;
}

.ps-btn {
  margin-top: 28rpx;
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 48rpx;
  border-radius: 16rpx;
  background: #1677FF;
  color: #FFFFFF;
  font-size: 28rpx;
}
