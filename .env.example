# Central SaaS local-development settings only. Do not use placeholders in production.
APP_ENV=local
# Production keeps DEPLOYMENT_MODE=saas and replaces SQLite with PostgreSQL.
DEPLOYMENT_MODE=saas
DATABASE_URL=sqlite+aiosqlite:///.data/poi_admin.sqlite3
SECRET_KEY=local-development-only-change-me
ENCRYPTION_KEY=local-development-only-change-me

# Optional application settings
APP_NAME=POI Hub
LOG_LEVEL=INFO
WECHAT_API_BASE_URL=https://api.weixin.qq.com
WECHAT_HTTP_MAX_CONNECTIONS=100
WECHAT_HTTP_MAX_KEEPALIVE_CONNECTIONS=20

# Central SaaS billing is tenant-based; the server must keep offline licensing disabled.
LICENSE_MODE=off

# Batch worker controls. Keep concurrency=1 for SQLite; PostgreSQL can scale this up.
WORKER_CONCURRENCY=1
WORKER_BURST_SIZE=100
WORKER_LEASE_SECONDS=120
WEBHOOK_MAX_ATTEMPTS=8

# SQLite is only for local development. Central production requires PostgreSQL.
SQLITE_BUSY_TIMEOUT_MS=10000
